{%- comment -%} {% render 'product-card', product: product, index: forloop.index0 %} {%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign published_s = product.published_at | date: '%s' | plus: 0 -%}
{%- assign age_days = now_s | minus: published_s | divided_by: 86400 -%}
<article class="product-card reveal" style="--reveal-delay: {{ index | default: 0 | modulo: 4 | times: 70 }}ms">
  <div class="product-photo">
  <a class="product-photo-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if on_sale -%}
      {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="product-badge badge-sale">-{{ pct }}%</span>
    {%- elsif product.tags contains 'bestseller' -%}
      <span class="product-badge badge-best">Bestseller</span>
    {%- elsif age_days < 21 -%}
      <span class="product-badge badge-new">Nieuw</span>
    {%- endif -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 861px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title, class: 'product-photo-main' }}
    {%- else -%}
      <span class="product-placeholder-label">{{ product.title }}</span>
    {%- endif -%}
    {%- if product.images[1] -%}
      {{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 861px) 25vw, 50vw', alt: '', class: 'product-photo-alt' }}
    {%- endif -%}
  </a>
  {%- if product.available -%}
    {%- if product.variants.size == 1 -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form" data-quick-add>
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" class="quick-add">+ Snel toevoegen</button>
      </form>
    {%- else -%}
      <a class="quick-add" href="{{ product.url }}">Kies je maat</a>
    {%- endif -%}
  {%- endif -%}
  </div>
  <div class="product-meta">
    <a class="product-title" href="{{ product.url }}">{{ product.title }}</a>
    {% render 'price', product: product %}
  </div>
</article>
