<section class="section-pad page-width">
  <div class="section-head"><h2 class="heading-font">{{ section.settings.heading }}</h2></div>
  <div class="tiles">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="tile reveal" style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 861px) 33vw, 100vw', alt: block.settings.title }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        <span class="tile-label heading-font">{{ block.settings.title }} {% render 'icon', name: 'arrow', size: 16 %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Assortiment-tegels",
  "settings": [{ "type": "text", "id": "heading", "label": "Kop", "default": "Shop het assortiment" }],
  "blocks": [
    { "type": "tile", "name": "Tegel", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Schoenen" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Afbeelding" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Assortiment-tegels", "blocks": [
    { "type": "tile", "settings": { "title": "Schoenen" } },
    { "type": "tile", "settings": { "title": "Tassen" } },
    { "type": "tile", "settings": { "title": "Accessoires" } }
  ] }]
}
{% endschema %}
