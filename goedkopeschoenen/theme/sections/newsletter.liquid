<section class="newsletter section-pad">
  <div class="page-width newsletter-inner">
    <div><h2 class="heading-font">{{ section.settings.heading }}</h2><p class="muted">{{ section.settings.subtext }}</p></div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}<p class="form-ok">Bedankt! Check je inbox voor je kortingscode.</p>{%- else -%}
        <input type="email" name="contact[email]" class="field" placeholder="Je e-mailadres" required aria-label="E-mailadres" autocomplete="email">
        <button class="btn btn-primary" type="submit">Aanmelden {% render 'icon', name: 'arrow', size: 16 %}</button>
      {%- endif -%}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "10% korting op je eerste aankoop" },
    { "type": "text", "id": "subtext", "label": "Subtekst", "default": "Meld je aan voor onze nieuwsbrief en mis geen actie." }
  ],
  "presets": [{ "name": "Nieuwsbrief" }]
}
{% endschema %}
