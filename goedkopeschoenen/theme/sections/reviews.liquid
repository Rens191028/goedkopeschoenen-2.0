<section class="trust-section section-pad">
  <div class="page-width">
    <div class="trust-grid">
      <div class="trust-stat reveal">
        <span class="heading-font trust-score">{{ settings.kiyoh_score }} / 10</span>
        {% render 'stars', rating: 5, size: 18 %}
        <p class="muted">Gebaseerd op {{ settings.kiyoh_count }} beoordelingen op Kiyoh — onafhankelijk geverifieerd.</p>
      </div>
      <div class="review-cards">
        {%- for block in section.blocks -%}
          <figure class="review-card reveal" style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
            {% render 'stars', rating: block.settings.rating, size: 13 %}
            <blockquote>“{{ block.settings.quote }}”</blockquote>
            <figcaption class="muted small">{{ block.settings.name }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
    <div class="trust-foot">
      <span>{{ settings.company_name }} · {{ settings.company_address }}</span>
      <span>KvK {{ settings.company_kvk }}</span>
      <span>BTW {{ settings.company_btw }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews & vertrouwen",
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Citaat", "default": "Vervang door een echt Kiyoh-citaat." },
      { "type": "text", "id": "name", "label": "Naam klant", "default": "Naam klant" },
      { "type": "range", "id": "rating", "label": "Sterren", "min": 1, "max": 5, "step": 1, "default": 5 }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Reviews & vertrouwen", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
