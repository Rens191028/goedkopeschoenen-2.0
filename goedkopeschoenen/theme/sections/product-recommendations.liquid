<section class="section-pad page-width product-recommendations" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section-head"><h2 class="heading-font">{{ section.settings.heading }}</h2></div>
    <div class="product-grid">
      {%- for product in recommendations.products -%}{% render 'product-card', product: product, index: forloop.index0 %}{%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Gerelateerde producten", "settings": [{ "type": "text", "id": "heading", "label": "Kop", "default": "Dit vind je misschien ook leuk" }], "presets": [{ "name": "Gerelateerde producten" }] }
{% endschema %}
