<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="page-width section-pad" style="text-align:center">
    <h1 class="heading-font">{{ shop.name }}</h1>
    <p>{{ shop.password_message }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" class="field" aria-label="Wachtwoord">
      <button class="btn btn-primary" type="submit">Openen</button>
    {% endform %}
  </main>
  {{ content_for_layout }}
</body>
</html>
